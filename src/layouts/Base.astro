---
import { site, apps, appGroups, href } from '../config';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const full = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const grouped = appGroups.map((name) => ({ name, items: apps.filter((a) => a.group === name) })).filter((g) => g.items.length > 0);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={href()}><span class="mark" aria-hidden="true">{site.name.slice(0, 1)}</span>{site.name}</a>
        <nav aria-label="Main">
          <details class="menu">
            <summary>Apps</summary>
            <div class="menu-panel">
              <div class="wrap menu-grid">
                {grouped.map((g) => (
                  <div class="menu-group">
                    <h4>{g.name}</h4>
                    {g.items.map((a) => (
                      <a class="menu-app" href={href(a.slug + '/')}>
                        <img src={href(a.icon)} alt="" width="32" height="32" />
                        <span><b>{a.name}</b><small>{a.audience}</small></span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
              <div class="wrap menu-all"><a href={href() + '#apps'}>See all apps</a></div>
            </div>
          </details>
          <a href={href('pricing/')}>Pricing</a>
          <a href={href('support/')}>Support</a>
        </nav>
      </div>
    </header>
    <p class="test-bar"><b>The web versions of these apps are for testing only.</b> Nothing you enter in them is kept. The real apps are for iPhone, iPad and Android.</p>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <a class="brand" href={href()}><span class="mark" aria-hidden="true">{site.name.slice(0, 1)}</span>{site.name}</a>
            <p class="muted">{site.tagline}</p>
          </div>
          <div>
            <h4>Apps</h4>
            {grouped.map((g) => (
              <>
                <p class="foot-group">{g.name}</p>
                {g.items.map((a) => <a href={href(a.slug + '/')}>{a.name}</a>)}
              </>
            ))}
          </div>
          <div>
            <h4>Help</h4>
            <a href={href('pricing/')}>Pricing</a>
            <a href={href('support/')}>Support</a>
            <a href={site.contactHref}>Send feedback</a>
          </div>
          <div>
            <h4>Legal</h4>
            <a href={href('terms/')}>Terms</a>
            <a href={href('privacy/')}>Privacy</a>
            <a href={href('refunds/')}>Refunds</a>
          </div>
        </div>
        <p class="small muted">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
    <script is:inline>
      // The Apps menu is a plain <details>; close it on Escape, on a click outside it, and when a link is chosen.
      var menu = document.querySelector('.menu');
      if (menu) {
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); } });
        document.addEventListener('click', function (e) { if (menu.open && !menu.contains(e.target)) menu.open = false; });
      }
    </script>
  </body>
</html>
