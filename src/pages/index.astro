---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { site, apps, href } from '../config';
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">For the web, iPhone, iPad and Android</p>
      <h1>Simple apps for the way you actually work, play, cook and fish.</h1>
    </div>
  </section>

  <section id="apps" class="wrap section">
    <h2>The apps</h2>
    <div class="grid apps">
      {apps.map((a) => <AppCard app={a} />)}
    </div>
    <p class="muted center" style="margin-top: 24px"><b>More apps are coming soon.</b> The web versions are for testing and trying things out. The apps themselves are coming to the Apple App Store and Google Play.</p>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2>On the web, iPhone, iPad and Android</h2>
      <p class="lead narrow-lead">You can try every app in your browser today, but the web versions are for testing. The iPhone, iPad and Android apps are the ones to keep your information in, and they are on their way to the stores.</p>
      <StoreBadges />
      <div class="grid three six">
        <div><h3>On the web, for testing</h3><p>Open the link to try an app on your phone, tablet or computer. It is for testing: what you enter may not be kept between visits, so use the iPhone, iPad or Android app for anything you want to keep.</p></div>
        <div><h3>On iPhone and iPad</h3><p>Coming to the Apple App Store, so you can find and install it the usual way.</p></div>
        <div><h3>On Android</h3><p>Coming to Google Play, with the same app and the same information.</p></div>
        <div><h3>Works offline</h3><p>Your information is saved on your device first, so a weak signal never stops you. It syncs when you are back online.</p></div>
        <div><h3>Always up to date</h3><p>The web test version updates on its own, and the store versions update through the store.</p></div>
        <div><h3>On any device</h3><p>The same app on your phone, tablet and computer, with no separate versions to buy.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section narrow center">
    <h2>Questions or ideas?</h2>
    <p class="lead">We are a small team building these with the people who use them. Tell us what would make them better.</p>
    <a class="btn primary" href={href('support/')}>Get in touch</a>
  </section>
</Base>
