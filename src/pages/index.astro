---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { site, apps, href } from '../config';
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">For the web, iPhone, iPad and Android</p>
      <h1>Simple apps for the way you actually work, play, cook and fish.</h1>
    </div>
  </section>

  <section id="apps" class="wrap section">
    <h2>The apps</h2>
    <div class="grid apps">
      {apps.map((a) => <AppCard app={a} />)}
    </div>
    <p class="muted center" style="margin-top: 24px"><b>More apps are coming soon.</b> Every app works on the web today and is coming to the Apple App Store and Google Play.</p>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2>On the web, iPhone, iPad and Android</h2>
      <p class="lead narrow-lead">Every app works in your browser today, and the iPhone, iPad and Android versions are on their way to the stores.</p>
      <StoreBadges />
      <div class="grid three six">
        <div><h3>On the web</h3><p>Open the link and you are in, on your phone, tablet or computer. There is nothing to download or wait for.</p></div>
        <div><h3>On iPhone and iPad</h3><p>Coming to the Apple App Store, so you can find and install it the usual way.</p></div>
        <div><h3>On Android</h3><p>Coming to Google Play, with the same app and the same information.</p></div>
        <div><h3>Works offline</h3><p>Your information is saved on your device first, so a weak signal never stops you. It syncs when you are back online.</p></div>
        <div><h3>Always up to date</h3><p>The web version updates on its own, and the store versions update through the store.</p></div>
        <div><h3>On any device</h3><p>The same app on your phone, tablet and computer, with no separate versions to buy.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section narrow center">
    <h2>Want an app of your own?</h2>
    <p class="lead">We build apps for the Apple App Store, Google Play and the web, and we are preparing store versions of our own too.</p>
    <a class="btn" href={href('build-an-app/')}>See how it works</a>
  </section>

  <section class="wrap section narrow center">
    <h2>Questions or ideas?</h2>
    <p class="lead">We are a small team building these with the people who use them. Tell us what would make them better.</p>
    <a class="btn primary" href={href('support/')}>Get in touch</a>
  </section>
</Base>
