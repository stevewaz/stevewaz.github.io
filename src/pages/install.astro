---
import Base from '../layouts/Base.astro';
import { apps, href } from '../config';
---
<Base title="Install an app" description="How to install our progressive web apps (PWAs) on your Home Screen or desktop, with no app store.">
  <section class="wrap section narrow">
    <h1>Install an app</h1>
    <p class="lead">These apps open in your browser, and you can add each one to your device so it looks and works like any other app. There is no app store and nothing to download.</p>

    <h2>What is a PWA?</h2>
    <p>Our apps are <b>progressive web apps</b>, or <b>PWAs</b>. A PWA is a website built to behave like an app: you open it once in your browser, choose "install" or "Add to Home Screen", and it gets its own icon and opens like any other app on your device.</p>
    <p>Compared with an app from a store:</p>
    <ul class="bullets">
      <li><b>No store, no download:</b> the link is the install. Share it with a teammate or a family member and they can be using it in a minute.</li>
      <li><b>Always current:</b> the app updates itself, so you never have to chase a new version.</li>
      <li><b>Works offline:</b> after the first visit, the app keeps working without a connection.</li>
      <li><b>Easy to remove:</b> take it off your Home Screen or desktop like any other app.</li>
      <li><b>One app for everything:</b> the same app on iPhone, iPad, Android and computers.</li>
    </ul>
    <p class="muted">Prefer not to install? You can use any of the apps in your browser as a normal website. Installing just makes it quicker to open and safer for your information.</p>

    <p id="detected" class="note" hidden></p>

    <div class="platforms">
    <div class="platform" id="iphone" data-platform="iphone">
    <h2>On an iPhone or iPad</h2>
    <ol class="steps">
      <li>Open the app's link in <b>Safari</b>.</li>
      <li>Tap the <b>Share</b> button (the square with an arrow).</li>
      <li>Choose <b>Add to Home Screen</b>, then tap <b>Add</b>.</li>
    </ol>
    <p class="muted">On iPhone and iPad, only Safari can add an app to the Home Screen. Other browsers can use the app but not install it.</p>
    </div>

    <div class="platform" id="android" data-platform="android">
    <h2>On an Android phone or tablet</h2>
    <ol class="steps">
      <li>Open the app's link in <b>Chrome</b>.</li>
      <li>Tap the <b>⋮ menu</b>, then <b>Install app</b> (or <b>Add to Home screen</b>).</li>
      <li>Confirm. The app appears with your others.</li>
    </ol>
    </div>

    <div class="platform" id="computer" data-platform="computer">
    <h2>On a computer</h2>
    <ol class="steps">
      <li>Open the app's link in <b>Chrome</b> or <b>Edge</b>.</li>
      <li>Click the <b>install</b> icon at the right of the address bar, or open the browser menu and choose <b>Install</b>.</li>
    </ol>
    </div>
    </div>

    <h2>Good to know</h2>
    <ul class="bullets">
      <li><b>Updates:</b> the app updates itself. When a new version is ready you will see a small "Update" prompt.</li>
      <li><b>Offline:</b> open the app once while you are online so it can set itself up for offline use. After that it works without a connection. What you enter is saved on your device and syncs when you are back online.</li>
      <li><b>Your information:</b> Heirloom, Family Game Night, Steady and FishLog keep what you enter on your device. Clearing your browser's site data would remove it, so installing the app to your Home Screen is the safest way to keep it.</li>
    </ul>

    <h2>Open an app</h2>
    <ul class="bullets">{apps.map((a) => <li><a href={a.appUrl}>{a.name}</a> · <a href={href(a.slug + '/')}>about it</a></li>)}</ul>
  </section>
</Base>

<script>
  // Put the steps for the visitor's own device first. Without JavaScript all three stay in their usual order.
  const ua = navigator.userAgent;
  const iOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  const platform = iOS ? 'iphone' : /Android/.test(ua) ? 'android' : 'computer';
  const names: Record<string, string> = { iphone: 'an iPhone or iPad', android: 'an Android device', computer: 'a computer' };
  const mine = document.getElementById(platform);
  const list = mine?.parentElement;
  const note = document.getElementById('detected');
  if (mine && list && note) {
    list.prepend(mine);
    mine.classList.add('mine');
    const otherBrowser = iOS && /CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
    note.textContent = `It looks like you are on ${names[platform]}, so those steps come first.` +
      (otherBrowser ? ' You are not in Safari: open this page in Safari to add an app to your Home Screen.' : '');
    note.hidden = false;
  }
</script>
