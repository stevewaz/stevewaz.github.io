---
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { apps, href, site } from '../config';
export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
---
<Base title={app.name} description={app.short}>
  <section class="hero app-hero" style={`--accent:${app.accent}`}>
    <div class="wrap">
      <img class="big-icon" src={href(app.icon)} alt={`${app.name} icon`} width="96" height="96" />
      <p class="eyebrow">{app.audience} · {app.status}</p>
      <h1>{app.headline}</h1>
      <p class="lead">{app.intro}</p>
      <div class="cta">
        <a class="btn primary" href={href(app.slug + '/get/')}>Get {app.name}</a>
        <a class="btn" href={app.appUrl}>Open on the web</a>
      </div>
      <ul class="ticks">{app.good.map((g) => <li>{g}</li>)}</ul>
    </div>
  </section>

  <section class="wrap section" style={`--accent:${app.accent}`}>
    <h2>What you can do</h2>
    <div class="grid features">
      {app.features.map((f) => <div class="card feature"><h3>{f.title}</h3><p>{f.text}</p></div>)}
    </div>
  </section>

  <section class="wrap section narrow" style={`--accent:${app.accent}`}>
    <h2>On the web, iPhone, iPad and Android</h2>
    <p>{app.name} works on the web today, in any modern browser, and keeps working when the internet drops. The iPhone, iPad and Android versions are coming to the Apple App Store and Google Play.</p>
    <StoreBadges apple={app.stores?.apple} google={app.stores?.google} />
    <p><a class="btn" href={app.appUrl}>Use {app.name} on the web</a></p>
  </section>

  <section class="band" style={`--accent:${app.accent}`}>
    <div class="wrap section narrow">
      <div class="card getcard">
        <span class="pill big">{app.pricing.title}</span>
        <p class="price"><strong>Free</strong><span class="muted">for now · {app.account ? 'free account' : 'no account'}, no card needed</span></p>
        <p>{app.pricing.text}</p>
        {app.notYet && <p class="note">{app.notYet}</p>}
        <div class="cta">
          <a class="btn primary" href={href(app.slug + '/get/')}>Get {app.name}</a>
          <a class="btn" href={href('support/')}>Ask a question</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section narrow">
    <h2>Other apps</h2>
    <div class="grid apps">
      {apps.filter((a) => a.slug !== app.slug).map((a) => (
        <a class="card app-card" href={href(a.slug + '/')} style={`--accent:${a.accent}`}>
          <img class="icon" src={href(a.icon)} alt="" width="48" height="48" loading="lazy" />
          <div><h3>{a.name}</h3><p>{a.short}</p></div>
        </a>
      ))}
      <div class="card app-card">
        <div><h3>More apps coming soon</h3><p>We are always building the next one. <a href={href('build-an-app/')}>Have an idea for an app?</a></p></div>
      </div>
    </div>
  </section>
</Base>
