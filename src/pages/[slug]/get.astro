---
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { apps, href } from '../../config';
export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
let n = 0;
const step = () => ++n;
---
<Base title={`Get ${app.name}`} description={`How to get ${app.name} on the web, iPhone, iPad and Android. It is free for now, with no card.`}>
  <section class="hero app-hero" style={`--accent:${app.accent}`}>
    <div class="wrap narrow">
      <img class="big-icon" src={href(app.icon)} alt={`${app.name} icon`} width="96" height="96" />
      <p class="eyebrow">{`Free for now · ${app.account ? 'Free account' : 'No account'} · No card needed`}</p>
      <h1>Get {app.name}</h1>
      <p class="lead">Use {app.name} on the web today. The iPhone, iPad and Android apps are coming to the Apple App Store and Google Play.</p>
    </div>
  </section>

  <section class="wrap section narrow" style={`--accent:${app.accent}`}>
    <ol class="get-steps">
      <li class="card get-step">
        <span class="num">{step()}</span>
        <div>
          <h2>Use {app.name} on the web</h2>
          <p>It opens in your browser and works right away.</p>
          <a class="btn primary" href={app.appUrl}>Open {app.name}</a>
        </div>
      </li>

      {app.account && (
        <li class="card get-step">
          <span class="num">{step()}</span>
          <div>
            <h2>Create your account</h2>
            <p>{app.account} There is nothing to pay.</p>
          </div>
        </li>
      )}

      <li class="card get-step">
        <span class="num">{step()}</span>
        <div>
          <h2>Get the app</h2>
          <p>The iPhone, iPad and Android versions are on their way. These buttons will link to the store listings when they are live.</p>
          <StoreBadges apple={app.stores?.apple} google={app.stores?.google} />
        </div>
      </li>
    </ol>

    <p class="center" style="margin-top: 32px"><a href={href(app.slug + '/')}>Back to {app.name}</a> · <a href={href('support/')}>Need help?</a></p>
  </section>
</Base>
