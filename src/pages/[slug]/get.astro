---
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { apps, href } from '../../config';
export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
let n = 0;
const step = () => ++n;
---
<Base title={`Get ${app.name}`} description={`How to get ${app.name} on iPhone, iPad and Android, and how to try the web version, which is for testing only. It is in beta, with no card needed.`}>
  <section class="hero app-hero" style={`--accent:${app.accent}`}>
    <div class="wrap narrow">
      <img class="big-icon" src={href(app.icon)} alt={`${app.name} icon`} width="96" height="96" />
      <p class="eyebrow">{`Beta · ${app.account ? 'Account' : 'No account'} · No card needed`}</p>
      <h1>Get {app.name}</h1>
      <p class="lead">The iPhone, iPad and Android apps are coming to the Apple App Store and Google Play. Until then you can try the web version, which is for testing only.</p>
    </div>
  </section>

  <section class="wrap section narrow" style={`--accent:${app.accent}`}>
    <ol class="get-steps">
      <li class="card get-step">
        <span class="num">{step()}</span>
        <div>
          <h2>Try {app.name} on the web (for testing)</h2>
          <p>It opens in your browser so you can look around. It is for testing only: there is no sign-in, and what you enter is not kept.</p>
          <a class="btn" href={app.appUrl}>Try {app.name} (for testing)</a>
        </div>
      </li>

      {app.account && (
        <li class="card get-step">
          <span class="num">{step()}</span>
          <div>
            <h2>Create your account in the app</h2>
            <p>{app.account} Accounts are made in the iPhone, iPad and Android app, not on the web. There is nothing to pay.</p>
          </div>
        </li>
      )}

      <li class="card get-step">
        <span class="num">{step()}</span>
        <div>
          <h2>Get the app</h2>
          <p>The iPhone, iPad and Android versions are on their way. These buttons will link to the store listings when they are live.</p>
          <StoreBadges apple={app.stores?.apple} google={app.stores?.google} />
        </div>
      </li>
    </ol>

    <p class="center" style="margin-top: 32px"><a href={href(app.slug + '/')}>Back to {app.name}</a> · <a href={href('support/')}>Need help?</a></p>
  </section>
</Base>
